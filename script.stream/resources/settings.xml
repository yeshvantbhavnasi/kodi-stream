<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
    <category label="General">
        <setting id="autostart" type="bool" label="Open Stream when Kodi starts" default="true"/>
    </category>
    <category label="AI">
        <setting id="ai_enabled" type="bool" label="Use AI for recommendations and search" default="true"/>
        <setting id="recs_url" type="text" label="Recommendation service (Stream's own; the public address works from any network; blank to ask Ollama directly)" default="https://recs.senapati.si"/>
        <setting id="recs_key" type="text" option="hidden" visible="false" label="Recommendation service key" default="7f48e2e1859d0e248af84902"/>
        <setting id="ollama_url" type="text" label="Ollama server (local model, used when the service address is blank)" default=""/>
        <setting id="ollama_model" type="text" label="Ollama model" default="gemma3:4b"/>
        <setting id="bedrock_token" type="text" option="hidden" label="Amazon Bedrock API key (when set, Claude on Bedrock answers instead of the service)" default=""/>
        <setting id="bedrock_region" type="text" label="Bedrock region" default="us-east-1"/>
        <setting id="bedrock_model" type="text" label="Bedrock model ID" default="anthropic.claude-opus-5-5"/>
        <setting id="jev_key" type="text" option="hidden" label="Jev (TypeSafe) API key" default=""/>
    </category>
    <category label="Ratings and trailers">
        <setting id="tmdb_key" type="text" option="hidden" label="Your own TMDb API key (optional; a shared key is built in)" default=""/>
        <setting id="omdb_key" type="text" option="hidden" label="OMDb API key (IMDb rating, optional)" default=""/>
    </category>
    <category label="Problem reports">
        <setting id="report_enabled" type="bool" label="Send install notice and automatic problem reports to the developer" default="true"/>
    </category>
</settings>
