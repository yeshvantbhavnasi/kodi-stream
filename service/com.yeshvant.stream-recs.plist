<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.yeshvant.stream-recs</string>
    <key>ProgramArguments</key>
    <array><string>/usr/bin/python3</string><string>/Users/yeshvant/dev/kodi-stream/service/recs_server.py</string></array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PORT</key><string>8770</string>
        <!-- 127.0.0.1 for Kodi on this Mac; the Tailscale address for the other TV boxes on the tailnet; the home-network address for the Kindle's Recs tab -->
        <key>BIND</key><string>127.0.0.1,100.125.214.63,192.168.1.20</string>
        <key>OLLAMA_URL</key><string>http://127.0.0.1:11434</string>
        <key>OLLAMA_MODEL</key><string>gemma3:4b</string>
        <!-- the key every box must send (Stream setting "Recommendation service key"); also kept in ~/ollama-home/recs.key -->
        <key>TOKEN</key><string>CHANGE-ME</string>
        <!-- the pin another bot or person sends to post a list (POST /lists); the service key works too -->
        <key>POST_PIN</key><string>CHANGE-ME-TOO</string>
        <!-- the Kindle home screen, which shows the web page in its Recs tab and keeps its sign-in -->
        <key>EMBED_ORIGINS</key><string>http://192.168.1.175:8765</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/Users/yeshvant/Library/Logs/stream-recs.log</string>
    <key>StandardErrorPath</key><string>/Users/yeshvant/Library/Logs/stream-recs.log</string>
</dict>
</plist>
